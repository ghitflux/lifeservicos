# Database
DATABASE_URL="postgresql://applife:applife_password@localhost:5432/applife_db"

# ========================================
# API - Backend do life-system (porta 8000)
# ========================================
# O app mobile se conecta ao backend web do life-system
#
# 🚀 CONFIGURAÇÃO AUTOMÁTICA (RECOMENDADO):
#    Execute: npm run config:ip
#    Isso detectará automaticamente seu IP local e atualizará este arquivo
#
# ⚙️ CONFIGURAÇÃO MANUAL:
#    1. Descubra seu IP local:
#       - Windows: ipconfig (procure "Endereço IPv4" da Wi-Fi)
#       - macOS/Linux: ifconfig (procure interface wlan0 ou en0)
#    2. Substitua SEU_IP_AQUI pelo IP encontrado
#    3. Exemplo: http://192.168.3.8:8000
#
# 📱 IMPORTANTE:
#    - Celular e computador devem estar na MESMA rede Wi-Fi
#    - Backend deve estar rodando em: python manage.py runserver 0.0.0.0:8000
#    - Teste no navegador do celular: http://SEU_IP:8000/docs
#
# 🔧 CONFIGURAÇÕES POR PLATAFORMA:
#    - Dispositivo físico (Android/iOS): http://SEU_IP_LAN:8000
#    - Emulador Android: http://10.0.2.2:8000
#    - Produção: https://api.lifeservicos.com
#
EXPO_PUBLIC_API_URL="http://SEU_IP_AQUI:8000"
API_URL="http://SEU_IP_AQUI:8000"
